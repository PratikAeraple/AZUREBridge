{
  "name": "azurebridge-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:terraform-guard": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "node --check src/server.mjs && node --check tests/site.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "format:terraform": "terraform -chdir=terraform fmt -check -recursive",
    "validate:terraform": "terraform -chdir=terraform validate"
  }
}
